# --- OpenWA (inside Docker, reach it by its service name) ---
OPENWA_URL=http://openwa-api:2785
OPENWA_API_KEY=paste-an-operator-api-key-from-the-dashboard
# Must match the "secret" you register the webhook with (16+ characters)
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Who the bot answers: your number(s), country code, digits only ---
OWNER_NUMBERS=94771234567

# --- AI ---
GEMINI_API_KEY=paste-from-aistudio.google.com
GEMINI_MODEL=gemini-3.8-flash
# Optional: used when the main model is overloaded or out of quota
GEMINI_FALLBACK_MODEL=
GROQ_API_KEY=paste-from-console.groq.com
WHISPER_MODEL=whisper-large-v3-turbo

# --- Personality / misc ---
BOT_NAME=Sec
TZ=Asia/Colombo
HISTORY_LIMIT=20

# --- Second brain sync to Obsidian (optional) ---
# Private GitHub repo URL with a fine-grained token (Contents: read & write on that repo only):
# VAULT_GIT_REMOTE=https://YOUR_TOKEN@github.com/YOUR_USERNAME/second-brain.git
# VAULT_GIT_BRANCH=main

# --- Google Calendar (optional; see README "Google Calendar") ---
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=from `docker exec -it wa-bot node google-auth.js`
# Comma-separated calendars to read; new events go to the first. Default: primary
# GOOGLE_CALENDAR_IDS=primary
